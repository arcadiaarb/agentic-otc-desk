# Server-only. Never prefix with NEXT_PUBLIC_ and never commit .env.local
# From Firebase console > Project settings > Service accounts > Generate new private key (a JSON file)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value in double quotes, keeping the \n sequences as they appear in the JSON
FIREBASE_PRIVATE_KEY=
# openssl rand -base64 32  (the whole team must use the SAME key for the data they share)
ENCRYPTION_KEY=
