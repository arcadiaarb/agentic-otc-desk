# Server-only. Never prefix with NEXT_PUBLIC_ and never commit .env.local
# Firebase or any Database to store Public Metadata
# Firebase console > Project settings > Service accounts > Generate new private key (a JSON file)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value in double quotes, keeping the \n sequences as they appear in the JSON
FIREBASE_PRIVATE_KEY=
# openssl rand -base64 32 (whole team must share the SAME value for the data they share)
ENCRYPTION_KEY=
# openssl rand -base64 32 (signs login challenges and session cookies; changing it signs everyone out)
SESSION_SECRET=

# Negotiation AI: any OpenAI-compatible endpoint. There's a built-in fallback strategy.
# Later (NEAR AI Cloud): set BASE_URL=https://cloud-api.near.ai/v1, your NEAR AI key, and a model ID from their dashboard.
NEGOTIATION_AI_BASE_URL=
NEGOTIATION_AI_API_KEY=
NEGOTIATION_AI_MODEL=
# Reply budget per agent turn. Reasoning models need a lot (their thinking counts); chat models need little.
NEGOTIATION_AI_MAX_TOKENS=1500

# Listing Agent (/create) uses the same model as the negotiation agents above.
# Reasoning models should not overthink a form: set this to low not high.
# If your provider rejects the setting, the agent falls back to its rules
# and logs an AI error.
LISTING_AI_REASONING_EFFORT=low
LISTING_AI_MAX_TOKENS=800
# Cleanup of expired intents. A background cleanup already runs when the board is opened (at most every N minutes).
# CRON_SECRET additionally protects the manual/scheduled route: GET /api/cleanup-expired with "Authorization: Bearer <secret>".
CLEANUP_EVERY_MINUTES=30
CRON_SECRET=

# --- Settlement ---
# One switch for the whole app. testnet uses Tidepool's sandbox verifier. mainnet needs its token ids filled in lib/network.ts first.
NEXT_PUBLIC_NEAR_NETWORK=testnet
# The server account that submits the final atomic transaction and pays its gas (needs a little NEAR on that network).
# On testnet you can reuse a throwaway account, for example the seller key from `.proof/keys.json`. Never use a mainnet key here that holds real funds.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Signing windows after an agreement: the buyer signs first (short), then the seller gets a full window.
BUYER_SIGN_MINUTES=15
SELLER_SIGN_HOURS=24